# Авторизационные данные из кабинета разработчика GigaChat (developers.sber.ru)
# Client Secret / Авторизационные данные (Base64 строка)
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here

# Область действия: GIGACHAT_API_PERS (для физлиц) или GIGACHAT_API_CORP (для юрлиц)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat: GigaChat-2, GigaChat-2-Pro, GigaChat-3-Pro, GigaChat-3-Ultra
GIGACHAT_MODEL=GigaChat-2

# Проверка SSL-сертификатов (false рекомендуется, если на Windows не установлены сертификаты Минцифры)
GIGACHAT_VERIFY_SSL=false
